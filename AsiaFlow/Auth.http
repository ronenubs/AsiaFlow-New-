@baseUrl = https://localhost:7123

### Login - Success
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "testpassword"
}

### Login - Missing password
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "testuser"
}

### Login - Empty credentials
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "",
  "password": ""
}
